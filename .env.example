# ============================================================
# MedComplyAI - Environment Configuration Example
# Copy this file to .env and fill in values
# ============================================================

# ------------------------------------------------------------------
# Core Services
# ------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
OLLAMA_URL=http://localhost:11434

# ------------------------------------------------------------------
# Model Selection
# ------------------------------------------------------------------
# Main LLM (served via Ollama). Must be a tag Ollama can pull;
# qwen2.5:7b-instruct-fixed was a local Modelfile and is not pullable.
LLM_MODEL_ID=qwen2.5:7b-instruct

# Fast/thinking variants (can be same model)
LLM_MODEL_FAST=qwen2.5:7b-instruct
LLM_MODEL_THINKING=qwen2.5:7b-instruct

# Embedding model (served via Ollama). 669 MB and 1024 dimensions, so the
# embedding and main models coexist in memory on a 16 GB host.
# EMBEDDING_VECTOR_SIZE is derived from this and must not be set separately.
# Switching models needs a vector store reset: POST /api/v1/admin/reset-vector-store
EMBEDDING_MODEL_ID=mxbai-embed-large:latest

# Vision model for document screenshots
VISION_MODEL_ID=qwen3-vl:2b-thinking

# ------------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------------
QDRANT_COLLECTION=compliance_chunks

# ------------------------------------------------------------------
# Gap Analysis Tuning
# ------------------------------------------------------------------
# LLM timeout for gap analysis (seconds)
GAP_LLM_TIMEOUT=120

# Max concurrent runs per tenant
GAP_MAX_CONCURRENT_RUNS_PER_TENANT=1

# ------------------------------------------------------------------
# Advanced Gap Flags (enable per framework)
# ------------------------------------------------------------------
ADV_GAP_ENABLE_CTD=true
ADV_GAP_ENABLE_DRUG_LABELING=true
ADV_GAP_ENABLE_DEVICE_IFU=true
ADV_GAP_ENABLE_MDR=true
ADV_GAP_ENABLE_ISO=true
ADV_GAP_ENABLE_510K=true

# ------------------------------------------------------------------
# Audit / Compliance Framework Flags
# ------------------------------------------------------------------
# ISO 14971 and MDR GSPR are on because production deployments run them.
# ISO 13485 and 21 CFR 820 stay off: not run in production, not yet measured.
ENABLE_ISO14971_AUDIT=true
ENABLE_ISO13485_AUDIT=false
ENABLE_MDR_GSPR_AUDIT=true
ENABLE_FDA820_AUDIT=false

# ------------------------------------------------------------------
# Glass Box AI (Audit-safe explanations)
# ------------------------------------------------------------------
GLASSBOX_ENABLED=true
GROUNDING_BLOCK_ON_FAILURE=true

# ------------------------------------------------------------------
# Intelligence (Copilot / Drafts / Review)
# ------------------------------------------------------------------
INTELLIGENCE_EXPLANATION_ENABLED=true
INTELLIGENCE_COPILOT_ENABLED=true
INTELLIGENCE_DRAFTING_ENABLED=true

# ------------------------------------------------------------------
# Co-Pilot Workflows
# ------------------------------------------------------------------
ENABLE_COPILOT_LABEL_UPDATE=true
ENABLE_COPILOT_STRATEGY=true
ENABLE_COPILOT_CONSISTENCY=true
ENABLE_COPILOT_SUBMISSION_CHECK=true

# ------------------------------------------------------------------
# Observability (Optional)
# ------------------------------------------------------------------
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse Docker secrets (only needed when running with observability profile)
# Deliberately left empty. The observability profile refuses to start unless
# all three are set, so an unconfigured stack fails loudly instead of coming
# up with predictable secrets. Generate each with:
#   openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_DB_PASSWORD=

# ------------------------------------------------------------------
# Multi-Framework RAG (experimental)
# ------------------------------------------------------------------
ENABLE_MULTI_FRAMEWORK_RETRIEVAL=false
ENABLE_MULTI_FRAMEWORK_RAG=false
ENABLE_DSPY_OPTIMIZATION=false
ENABLE_WORKFLOW_ORCHESTRATION=false

# ------------------------------------------------------------------
# API Security (optional)
# ------------------------------------------------------------------
# Set to a secure random string to require an API key on gap endpoints
GAP_API_KEY=
