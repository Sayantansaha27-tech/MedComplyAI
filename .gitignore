# ============================================================
# MedComplyAI - .gitignore
# ============================================================

# Environment variables
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
# Anchored to the repo root. Unanchored, these match a directory of the
# same name at any depth and would silently exclude frontend/lib,
# frontend/build, and similar application paths.
/dist/
/build/
/eggs/
/parts/
/var/
/sdist/
/develop-eggs/
.installed.cfg
/lib/
/lib64/
*.pyc
*.pyo
*.pyd
.Python
/env/
venv/
/ENV/
.venv/
.env/
pip-wheel-metadata/
share/python-wheels/
*.egg-link
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/
Pipfile.lock

# Storage / uploaded data (never commit user data)
backend/storage/
!backend/storage/.gitkeep

# SQLite databases
*.db
*.sqlite
*.sqlite3

# Next.js
frontend/.next/
frontend/out/
frontend/node_modules/
frontend/.npm
frontend/.eslintcache
.next/
.vercel

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V4
.Trashes
ehthumbs.db
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Docker
.docker/

# Logs
*.log
logs/

# Build artifacts
*.tgz
*.tar.gz

# Secrets & credentials
*.pem
*.key
*.cert
*.crt
*.p12
service-account*.json

# ML / Model artifacts
*.gguf
*.bin
*.pt
*.safetensors
model_cache/
